# H2 Database 学习环境 .gitignore

# 编译产物
h2/bin/
h2/target/
h2/temp/
h2/ext/
h2/h2.iml

# 数据文件
data/
*.db
*.mv.db
*.h2.db
*.lock.db
*.trace.db

# IDE 文件
.idea/
*.iml
.vscode/
*.swp
*.swo

# 系统文件
.DS_Store
Thumbs.db

# 日志文件
*.log
logs/

# 临时文件
*.tmp
*.temp
*.bak
*.backup

# 测试输出
test-output/
test-results/

# Maven 相关（如果使用）
.mvn/wrapper/maven-wrapper.jar
.mvn/wrapper/maven-wrapper.properties

# 其他编译产物
*.class
*.jar
*.war
*.ear

# 学习笔记备份
*.backup
*.old
